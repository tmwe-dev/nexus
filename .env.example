NEXUS_ENV=development

# Nexus service-to-service auth. Production cutover requires enforce.
NEXUS_AUTH_MODE=audit
NEXUS_SERVICE_TOKEN_REGISTRY=

# Nexus durable control plane.
# Default deployment uses the existing Supabase project with the isolated
# nexus_control_plane schema. URL/publishable key have safe non-secret defaults
# in modules/idempotency/ledger.js and may be overridden here.
NEXUS_CONTROL_PLANE_URL=
NEXUS_CONTROL_PLANE_PUBLISHABLE_KEY=
# Service-role key is optional for user-scoped Funnemail idempotency and is
# required only for future service-to-service workflows such as Cobra.
# Never expose this value to browsers or commit a real key to GitHub.
NEXUS_CONTROL_PLANE_KEY=

# Idempotency modes are split by actor type.
# Funnemail user mutations are durably enforced by default through authenticated RPCs.
NEXUS_USER_IDEMPOTENCY_MODE=enforce
# Service-to-service workflows remain audit until a server-only service-role key is configured.
NEXUS_SERVICE_IDEMPOTENCY_MODE=audit
# Legacy fallback for service mode only; prefer the explicit variables above.
NEXUS_IDEMPOTENCY_MODE=audit
NEXUS_IDEMPOTENCY_TTL_SECONDS=86400

# WCA source
WCA_BASE_URL=
WCA_SERVICE_TOKEN=
WCA_DETAIL_MAX_PAGES=20

# Report Aziende source — configure only after provider review
REPORT_AZIENDE_BASE_URL=
REPORT_AZIENDE_SERVICE_TOKEN=

# COBRA orchestration service
COBRA_BASE_URL=
COBRA_SERVICE_TOKEN=
COBRA_CONNECT_TIMEOUT_MS=5000
COBRA_WORKFLOW_TIMEOUT_MS=55000

# Funnemail compatibility adapter — temporary rollback path only.
# Normal Mail routing no longer requires these values when the canonical boundary is healthy.
NEXUS_FUNNEMAIL_SUPABASE_URL=
NEXUS_FUNNEMAIL_ANON_KEY=
NEXUS_FUNNEMAIL_USER_TOKEN=

# Funnemail canonical owner boundary.
# This public non-secret URL is also defined as the canonical registry default;
# set FUNNEMAIL_BASE_URL only to override it for another environment/target.
FUNNEMAIL_BASE_URL=https://rxocvyfhsqduowltmfbp.supabase.co/functions/v1/funnemail-nexus-v1
FUNNEMAIL_BOUNDARY_TIMEOUT_MS=12000

# BarTalk / Voice Translator — canonical names.
BARTALK_BASE_URL=
BARTALK_SERVICE_TOKEN=
BARTALK_CONNECT_TIMEOUT_MS=5000

# Independent Nexus CRM store (PostgREST/Supabase compatible)
NEXUS_CRM_STORE_URL=
NEXUS_CRM_STORE_TOKEN=
# legacy | shadow | nexus. Keep legacy until migration gates pass.
NEXUS_CRM_READ_MODE=legacy

# Navigator shadow comparison only. Never use these as the independent CRM store.
NAVIGATOR_SUPABASE_URL=
NAVIGATOR_SUPABASE_KEY=
