COBRA_WORKFLOW_TIMEOUT_MS=55000

# Funnemail — configure only after the stable service boundary exists
FUNNEMAIL_BASE_URL=
FUNNEMAIL_SERVICE_TOKEN=

# BarTalk / Voice Translator
BARTALK_BASE_URL=
BARTALK_SERVICE_TOKEN=
