NEXUS_ENV=development

# WCA source
WCA_BASE_URL=
WCA_SERVICE_TOKEN=
WCA_DETAIL_MAX_PAGES=20

# Report Aziende source — configure only after provider review
REPORT_AZIENDE_BASE_URL=
REPORT_AZIENDE_SERVICE_TOKEN=

# COBRA orchestration service
COBRA_BASE_URL=
COBRA_SERVICE_TOKEN=
